{
  "name": "qa-interview-playwright-solution",
  "version": "1.0.0",
  "private": true,
  "description": "Reference solution for the QA code-review interview",
  "scripts": {
    "app": "ENABLE_TEST_ROUTES=true node app/server.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
